#!/bin/bash

# =============================================================================
# [북 리딩 로그 원클릭 클라우드 배포 실행 스크립트]
# 맥북 Finder에서 이 파일을 더블클릭하면:
# 1. 최신 독서 리포트를 집계(build_dashboard.py)합니다.
# 2. GitHub Pages 클라우드로 자동 푸시하여 24시간 스마트폰 모바일 주소를 발급합니다.
# =============================================================================

# 현재 스크립트가 위치한 폴더로 이동
cd "$(dirname "$0")"

# 배포 도구 실행
python3 "deploy_cloud.py"

echo ""
echo "👉 아무 키나 누르시면 창이 닫힙니다..."
read -n 1

