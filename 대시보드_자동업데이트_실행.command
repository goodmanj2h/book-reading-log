#!/bin/bash

# =============================================================================
# [북 리딩 로그 대시보드 원클릭 자동 실행 스크립트]
# 맥북 Finder에서 이 파일을 더블클릭하면:
# 1. 브라우저로 Book Reading Log 대시보드(index.html)가 자동으로 열립니다.
# 2. 폴더 실시간 감시자(auto_watcher.py)가 가동되어 파일 추가 시 즉각 반영됩니다.
# =============================================================================

# 현재 스크립트가 위치한 폴더로 이동
cd "$(dirname "$0")"

echo "================================================================="
echo "  📚 Book Reading Log 대시보드 시스템을 가동합니다."
echo "================================================================="
echo ""
echo " 1. 기본 웹 브라우저에서 독서 대시보드를 엽니다..."
open "index.html"

echo " 2. 폴더 실시간 감시자를 시작합니다..."
echo "    -> 이제 연도/월 폴더에 새 독서 HTML을 넣기만 하면 자동 반영됩니다!"
echo ""
echo " (종료하시려면 이 터미널 창을 닫으시거나 Ctrl + C 를 누르세요)"
echo "-----------------------------------------------------------------"

# 실시간 감시자 실행
python3 "auto_watcher.py"

